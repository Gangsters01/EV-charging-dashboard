-- =========================================================
-- 9. INCREMENTAL LOAD (FIXED STREAM USAGE)
-- =========================================================
CREATE OR REPLACE PROCEDURE LOAD_SESSIONS_INCREMENTAL()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN

MERGE INTO RAW.SESSIONS_RAW tgt
USING (
    SELECT * FROM RAW.SESSIONS_STREAM
    WHERE METADATA$ACTION = 'INSERT'
) src
ON tgt.session_id = src.session_id

WHEN MATCHED THEN UPDATE SET 
    energy_kwh = src.energy_kwh,
    duration_sec = src.duration_sec

WHEN NOT MATCHED THEN INSERT VALUES (
    src.session_id, src.user_id, src.vehicle_id, src.charger_id,
    src.start_time, src.end_time, src.energy_kwh,
    src.duration_sec, src.tariff_type, src.price,
    src.start_soc, src.end_soc, src.grid_meter_reading,
    src.payment_channel, src.is_flagged
);

RETURN 'Incremental Load Completed';

END;
$$;

-- =========================================================
-- 10. ADVANCED ANOMALY DETECTION
-- =========================================================
CREATE OR REPLACE TABLE CURATED.ANOMALIES AS
SELECT s.*,
CASE 
    WHEN (end_soc - start_soc) > 30 AND duration_sec < 120 THEN 'SOC_JUMP'
    WHEN duration_sec = 0 THEN 'INVALID_SESSION'
    WHEN energy_kwh > 150 THEN 'ENERGY_ANOMALY'
    WHEN EXISTS (
        SELECT 1 FROM VALIDATED.SESSIONS_FINAL s2
        WHERE s.user_id = s2.user_id
        AND s.session_id <> s2.session_id
        AND s.start_time_utc < s2.end_time_utc
        AND s.end_time_utc > s2.start_time_utc
    ) THEN 'PARALLEL_SESSION'
END AS anomaly_type
FROM VALIDATED.SESSIONS_FINAL s;

