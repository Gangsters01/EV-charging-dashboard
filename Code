-- =========================================================
-- 7. VALIDATED LAYER
-- =========================================================

CREATE OR REPLACE TABLE VALIDATED.SESSIONS AS
SELECT *,
    CONVERT_TIMEZONE('UTC', start_time) AS start_time_utc,
    CONVERT_TIMEZONE('UTC', end_time) AS end_time_utc,
    TO_BOOLEAN(is_flagged) AS is_flagged_bool
FROM RAW.SESSIONS_RAW;

CREATE OR REPLACE TABLE VALIDATED.SESSIONS_CLEAN AS
SELECT *
FROM VALIDATED.SESSIONS
WHERE energy_kwh >= 0
  AND duration_sec >= 0
  AND start_soc BETWEEN 0 AND 100
  AND end_soc BETWEEN 0 AND 100
  AND end_time_utc >= start_time_utc;

CREATE OR REPLACE TABLE VALIDATED.SESSIONS_DEDUP AS
SELECT *
FROM (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY session_id ORDER BY start_time_utc DESC) rn
    FROM VALIDATED.SESSIONS_CLEAN
)
WHERE rn = 1;

CREATE OR REPLACE TABLE VALIDATED.SESSIONS_FINAL AS
SELECT s.*
FROM VALIDATED.SESSIONS_DEDUP s
JOIN RAW.CHARGERS_RAW c ON s.charger_id = c.charger_id
JOIN RAW.USERS_RAW u ON s.user_id = u.user_id;

CREATE OR REPLACE TABLE VALIDATED.STATIONS AS
SELECT * FROM RAW.STATIONS_RAW WHERE capacity_kw >= 0;

CREATE OR REPLACE TABLE VALIDATED.CHARGERS AS
SELECT * FROM RAW.CHARGERS_RAW WHERE max_kw > 0;

CREATE OR REPLACE TABLE VALIDATED.USERS AS
SELECT * FROM RAW.USERS_RAW;

CREATE OR REPLACE TABLE VALIDATED.VEHICLES AS
SELECT * FROM RAW.VEHICLES_RAW;

