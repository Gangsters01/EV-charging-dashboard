-- =========================================================
-- 12. TASK (FIXED USING PROCEDURE WRAPPER)
-- =========================================================


CREATE OR REPLACE PROCEDURE RUN_PIPELINE()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN

  -- STEP 1: INCREMENTAL LOAD
  CALL LOAD_SESSIONS_INCREMENTAL();

  -- STEP 2: REFRESH VALIDATED LAYER
  CREATE OR REPLACE TABLE VALIDATED.SESSIONS AS
  SELECT *,
      CONVERT_TIMEZONE('UTC', start_time) AS start_time_utc,
      CONVERT_TIMEZONE('UTC', end_time) AS end_time_utc,
      TO_BOOLEAN(is_flagged) AS is_flagged_bool
  FROM RAW.SESSIONS_RAW;

  -- STEP 3: DATA QUALITY FILTER
  CREATE OR REPLACE TABLE VALIDATED.SESSIONS_CLEAN AS
  SELECT *
  FROM VALIDATED.SESSIONS
  WHERE energy_kwh >= 0
    AND duration_sec >= 0
    AND start_soc BETWEEN 0 AND 100
    AND end_soc BETWEEN 0 AND 100
    AND end_time_utc >= start_time_utc;

  -- STEP 4: DEDUP
  CREATE OR REPLACE TABLE VALIDATED.SESSIONS_DEDUP AS
  SELECT *
  FROM (
      SELECT *,
             ROW_NUMBER() OVER (PARTITION BY session_id ORDER BY start_time_utc DESC) rn
      FROM VALIDATED.SESSIONS_CLEAN
  )
  WHERE rn = 1;

  -- STEP 5: FINAL VALIDATED
  CREATE OR REPLACE TABLE VALIDATED.SESSIONS_FINAL AS
  SELECT s.*
  FROM VALIDATED.SESSIONS_DEDUP s
  JOIN RAW.CHARGERS_RAW c ON s.charger_id = c.charger_id
  JOIN RAW.USERS_RAW u ON s.user_id = u.user_id;

  -- STEP 6: REFRESH FACT TABLE
  CREATE OR REPLACE TABLE CURATED.FACT_SESSIONS AS
  SELECT 
      session_id,
      user_id,
      vehicle_id,
      charger_id,
      energy_kwh,
      duration_sec,
      price,
      tariff_type,
      start_time_utc,
      end_time_utc
  FROM VALIDATED.SESSIONS_FINAL;

  -- STEP 7: LOGGING
  INSERT INTO LOGS.PIPELINE_LOGS
  SELECT CURRENT_TIMESTAMP, 'FACT_SESSIONS', COUNT(*) 
  FROM CURATED.FACT_SESSIONS;

  RETURN 'PIPELINE SUCCESS';

END;
$$;

-- TASK
CREATE OR REPLACE TASK EV_PIPELINE_TASK
WAREHOUSE = COMPUTE_WH
SCHEDULE = '5 MINUTE'
AS
CALL RUN_PIPELINE();

