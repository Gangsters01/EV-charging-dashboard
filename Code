-- 14. FINAL KPIs
-- =========================================================

SELECT COUNT(*) * 100.0 / (SELECT COUNT(*) FROM CURATED.FACT_SESSIONS)
FROM CURATED.ANOMALIES;

SELECT charger_id,
COUNT(CASE WHEN status IN ('Available','Charging') THEN 1 END) * 100.0 / COUNT(*) AS uptime
FROM CURATED.DIM_CHARGERS
GROUP BY charger_id;

SELECT COUNT(DISTINCT user_id) * 100.0 /
(SELECT COUNT(*) FROM CURATED.DIM_USERS)
FROM CURATED.FACT_SESSIONS
WHERE start_time_utc >= DATEADD(day, -30, CURRENT_DATE());

SELECT st.city,
COUNT(CASE WHEN f.energy_kwh < 50 THEN 1 END)*100.0/COUNT(*) AS balanced_load_pct
FROM CURATED.FACT_SESSIONS f
JOIN CURATED.DIM_CHARGERS c ON f.charger_id = c.charger_id
JOIN CURATED.DIM_STATIONS st ON c.station_id = st.station_id
GROUP BY st.city;

SELECT tariff_type, AVG(price)
FROM CURATED.FACT_SESSIONS
GROUP BY tariff_type;
