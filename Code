-- 8. CURATED LAYER (FIXED SCD-2)
-- =========================================================


CREATE OR REPLACE TABLE CURATED.DIM_STATIONS (
    station_id STRING,
    station_name STRING,
    city STRING,
    zone STRING,
    capacity_kw FLOAT,
    status STRING,
    start_date DATE,
    end_date DATE,
    is_current BOOLEAN
);

-- STEP 1: CLOSE OLD RECORDS
UPDATE CURATED.DIM_STATIONS tgt
SET end_date = CURRENT_DATE(),
    is_current = FALSE
FROM VALIDATED.STATIONS src
WHERE tgt.station_id = src.station_id
  AND tgt.is_current = TRUE
  AND (
      tgt.capacity_kw != src.capacity_kw
      OR tgt.status != src.status
  );

-- STEP 2: INSERT NEW RECORDS (NEW + CHANGED)
INSERT INTO CURATED.DIM_STATIONS
SELECT 
    src.station_id,
    src.station_name,
    src.city,
    src.zone,
    src.capacity_kw,
    src.status,
    CURRENT_DATE() AS start_date,
    NULL AS end_date,
    TRUE AS is_current
FROM VALIDATED.STATIONS src
LEFT JOIN CURATED.DIM_STATIONS tgt
    ON src.station_id = tgt.station_id
    AND tgt.is_current = TRUE
WHERE tgt.station_id IS NULL
   OR (
       tgt.capacity_kw != src.capacity_kw
       OR tgt.status != src.status
   );

